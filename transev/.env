# EV CMS API origin (scheme + host + optional port only - no path).
# Per USERAPP_FE_HANDOFF_3.md section 2, the app derives everything else:
#   API_BASE_URL       = {origin}/api/v1
#   USER_APP_ROOT       = {origin}/api/v1/app
#   USER_APP_AUTH_ROOT  = {origin}/api/v1/app/auth
VITE_EV_CMS_API_ORIGIN=https://dev-evcmsnew.transev.site

# Routing header required on every /api/v1/app request (including /app/auth).
# This selects which CPO the app talks to. It is NOT a secret.
# Replace with the app id issued for this CPO/build.
VITE_CPO_APP_ID=cpo_dummy_5f75674f57829da5f3cae19ef4238d56
