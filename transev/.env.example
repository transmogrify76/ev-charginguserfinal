# Copy this file to .env (or .env.local) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client code.

# EV CMS API origin - scheme + host + optional port ONLY. No path, no
# trailing slash, and never /api/v1, /app, or /app/auth appended here.
VITE_EV_CMS_API_ORIGIN=https://dev-evcmsnew.transev.site

# X-CPO-App-ID sent on every /api/v1/app request. This is deploy-time
# app configuration (one trusted value per branded CPO build), not a secret
# and not authority by itself.
VITE_CPO_APP_ID=
